# Public client config — copy to `.env` (gitignored).
# Never put SUPABASE_SERVICE_ROLE_KEY, Firebase server keys, or AI secrets here.
#
# Production Auth: keep Email Confirmation ON in Supabase Dashboard.
# Local-only projects may turn it off for smoke testing.
#
# APP_ENV selection (rebuild native after changes — react-native-config):
# - development: local Debug builds / default `.env`
# - production: Release builds must use `.env.production` with production public Supabase URL + anon key
#
# Firebase native mapping (same package/bundle IDs across backends):
# - place client files under config/firebase/{development,production}/
# - run `pnpm run firebase:config` (also hooked from preandroid/preios and Android Gradle)

APP_ENV=development

# Public Supabase (ship in the JS bundle — protect via RLS)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional external REST (axios only). Leave blank if unused.
API_BASE_URL=
