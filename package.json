{
  "name": "TanLabsEnglishForSE",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "android": "react-native run-android --active-arch-only",
    "ios": "react-native run-ios",
    "ios:dev": "react-native run-ios --mode Debug",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run format:check",
    "preandroid": "pnpm run check",
    "preios": "pnpm run check",
    "start": "react-native start",
    "test": "jest",
    "test:coverage": "COVERAGE_ENFORCE=1 jest --ci --coverage --coverageReporters=text-summary",
    "test:coverage:enforce": "COVERAGE_ENFORCE=1 jest --ci --coverage --coverageReporters=text-summary",
    "test:coverage:soft": "COVERAGE_ENFORCE=0 jest --ci --coverage --coverageReporters=text-summary",
    "audit:security": "node scripts/audit-dependencies.mjs",
    "prepare": "husky",
    "fastlane:doctor": "bundle exec fastlane doctor",
    "fastlane:ios:build": "bundle exec fastlane ios build",
    "fastlane:ios:beta": "bundle exec fastlane ios beta",
    "fastlane:android:build": "bundle exec fastlane android build",
    "fastlane:android:bundle": "bundle exec fastlane android bundle",
    "fastlane:android:beta": "bundle exec fastlane android beta",
    "typecheck": "tsc --noEmit",
    "verify:rls": "bash scripts/verify-rls.sh",
    "secret:scan": "bash scripts/secret-scan.sh",
    "verify:hooks": "bash scripts/verify-hooks.sh",
    "db:migrate": "bash scripts/apply-migrations.sh",
    "db:types": "bash scripts/gen-database-types.sh",
    "e2e:ios": "bash scripts/e2e-ios.sh",
    "e2e:android": "bash scripts/e2e-android.sh"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.13.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/analytics": "^26.1.0",
    "@react-native-firebase/app": "^26.1.0",
    "@react-native-firebase/crashlytics": "^26.1.0",
    "@react-native-firebase/messaging": "^26.1.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "axios": "^1.19.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-bootsplash": "^7.3.2",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.27.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^17.3.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "reactotron-react-native": "^5.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
