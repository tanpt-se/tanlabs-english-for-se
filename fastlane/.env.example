# Copy to fastlane/.env (gitignored) for local runs.
# On CI, inject the same keys as secrets.

# --- App IDs ---
IOS_BUNDLE_ID=com.tanlabs.en-for-se
ANDROID_PACKAGE_NAME=com.tanlabs.enforse

# --- Apple / App Store Connect ---
APPLE_ID=you@example.com
APPLE_TEAM_ID=XXXXXXXXXX
ITC_TEAM_ID=
# App Store Connect API key (preferred over Apple ID password):
# APP_STORE_CONNECT_API_KEY_PATH=./fastlane/AuthKey_XXXXX.p8
# APP_STORE_CONNECT_API_KEY_ID=XXXXX
# APP_STORE_CONNECT_API_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Match (code signing) ---
MATCH_GIT_URL=git@github.com:org/certificates.git
MATCH_PASSWORD=change-me
MATCH_USERNAME=you@example.com

# --- Google Play ---
# Path to service account JSON (never commit the JSON)
GOOGLE_PLAY_JSON_KEY=./fastlane/play-store-key.json

ANDROID_KEYSTORE_PATH=/absolute/path/to/upload-key.keystore
ANDROID_KEYSTORE_PASSWORD=change-me
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=change-me
